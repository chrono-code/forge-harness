<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Replace every /path/to/... below with your own absolute paths before installing -->
    <key>Label</key>
    <string>com.forge-harness.frontier-digest</string>

    <!-- Points at the autopilot WRAPPER (not frontier_digest_daily.sh directly). The wrapper runs
         the unchanged digest job first (Stage 1), then — only if the digest succeeded, the working
         tree is clean, and no other autopilot PR is already open — an unattended Stage 2 that may
         open a PR (never merge) via harvest-loop's own 4-axis gate. If you want digest-only with no
         Stage 2 autonomy, point this at scripts/frontier_digest_daily.sh instead.
         Existing installs: re-run `launchctl unload/load` after editing the deployed plist under
         ~/Library/LaunchAgents to pick this up — this tracked copy is the template, not the live one. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/forge-harness/scripts/frontier_digest_autopilot.sh</string>
    </array>

    <!-- Daily at 09:00 — change Hour to adjust -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/path/to/forge-harness/tracks/_meta/logs/launchd_out.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/forge-harness/tracks/_meta/logs/launchd_err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <!-- /opt/homebrew/bin included for the same reason as com.forge-harness.live-eval.plist:
             a launchd job's PATH otherwise never sees Homebrew (Apple Silicon prefix; Intel's
             /usr/local/bin is already below), so any GNU-coreutils-only tool this pipeline or a
             skill it calls shells out to would silently resolve to nothing here even though it
             works fine from an interactive shell. See sim_isolated_run.sh's §timeout(1)
             RESOLUTION header for the incident that surfaced this PATH gap (2026-09-05). -->
        <string>/path/to/home/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/path/to/home</string>
        <!-- The default model saved via `/model` also applies to unattended `claude -p` runs
             (~/.claude/settings.json `model`), so the unattended job's model is pinned HERE
             explicitly rather than inherited implicitly. Operator decision 2026-09-05 = opus. -->
        <key>FD_MODEL</key>
        <string>opus</string>
    </dict>
</dict>
</plist>
