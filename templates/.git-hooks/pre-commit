    echo "  ⏭️  SKIP — 게이트 pathspec 에 걸린 파일이 없다 (검사 안 함 ≠ 통과)"
  elif [ "$GUARD_EXIT" -eq 0 ]; then
    echo "  ✅ PASS"
  elif [ "$GUARD_EXIT" -eq 1 ]; then
